# Copy to .env (never commit .env). Gemini runs on Vertex AI with your gcloud credentials:
#   gcloud auth application-default login
VERTEXAI_PROJECT=
VERTEXAI_LOCATION=global
# Optional: a Steam Web API key (most endpoints we use don't need one).
STEAM_API_KEY=
# 1 = run every tool on the fake data in tools/fakes.py (default until the real tools work).
USE_FAKE_TOOLS=1
